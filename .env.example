# AdPilot AI - Environment Configuration
# Copy this file to .env to configure your live credentials

# ==============================================================================
# 1. META MARKETING API (Facebook & Instagram Ads Management & Insights Graph)
# ==============================================================================
# Get your Meta Developer credentials from https://developers.facebook.com
META_APP_ID=123456789012345
META_APP_SECRET=your_meta_app_secret_here
# Meta System User / Long-Lived Access Token with ads_management & ads_read
META_ACCESS_TOKEN=your_meta_system_user_access_token_here
# Ad Account ID from Meta Ads Manager (starts with act_)
META_AD_ACCOUNT_ID=act_1234567890

# ==============================================================================
# 2. LLM CREATIVE ENGINE (Groq / OpenAI)
# ==============================================================================
# Free Groq key from https://console.groq.com/keys (ultra-fast Llama-3.3-70b)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Alternatively, OpenAI API Key (gpt-4o / gpt-4o-mini)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# ==============================================================================
# 3. SAFEPAY SANDBOX PAYMENT GATEWAY
# ==============================================================================
# Get sandbox keys from https://sandbox.getsafepay.com
SAFEPAY_API_KEY=sec_sandbox_example_key
SAFEPAY_SECRET_KEY=sandbox_secret_key_here
SAFEPAY_ENV=sandbox

# Platform Commission Model (Percentage charged on top of ad media budget)
VITE_PLATFORM_COMMISSION_PERCENT=10

# ==============================================================================
# 4. SUPABASE AUTHENTICATION (Google OAuth & Free OTP Email)
# ==============================================================================
VITE_SUPABASE_URL=https://rqqjpusuubbfjijgwuht.supabase.co
